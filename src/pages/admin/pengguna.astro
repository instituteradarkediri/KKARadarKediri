          <td>
            ${u.is_active !== false 
              ? '<span class="petugas-status-badge status-active"><i class="bi bi-check-circle-fill"></i><span>Aktif</span></span>'
              : '<span class="petugas-status-badge status-inactive"><i class="bi bi-dash-circle"></i><span>Nonaktif</span></span>'
            }
          </td>
          <td>
            <div class="petugas-lastlogin-text">
              <i class="bi bi-clock"></i>
              <span>${formatDate(u.last_login)}</span>
            </div>
          </td>
          <td class="text-end pe-4">
            <button type="button" class="btn-edit-account" data-id="${u.id}">
              <i class="bi bi-pencil-square"></i>
              <span>Edit</span>
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });

      attachTableActionListeners();
    }

    // Pasang Event Listeners pada Tombol Aksi Tabel
    function attachTableActionListeners() {
      // 1. Toggle Peek Password
      document.querySelectorAll('.btn-peek-pass').forEach(btn => {
        btn.addEventListener('click', () => {
          const container = btn.closest('td');
          const passSpan = container?.querySelector('.password-display-text') as HTMLElement;
          const icon = btn.querySelector('i');
          if (!passSpan || !icon) return;

          const isRevealed = passSpan.getAttribute('data-revealed') === 'true';
          const realPass = passSpan.getAttribute('data-pass') || '';

          if (isRevealed) {
            passSpan.textContent = '••••••••••••';
            passSpan.setAttribute('data-revealed', 'false');
            icon.className = 'bi bi-eye';
          } else {
            passSpan.textContent = realPass;
            passSpan.setAttribute('data-revealed', 'true');
            icon.className = 'bi bi-eye-slash text-danger';
          }
        });
      });

      // 2. Copy Password
      document.querySelectorAll('.btn-copy-pass').forEach(btn => {
        btn.addEventListener('click', async () => {
          const pass = btn.getAttribute('data-pass') || '';
          if (!pass) return;
          try {
            await navigator.clipboard.writeText(pass);
            const icon = btn.querySelector('i');
            if (icon) {
              icon.className = 'bi bi-check2 text-success';
              setTimeout(() => {
                icon.className = 'bi bi-clipboard text-primary';
              }, 1500);
            }
            showToast('Kata sandi berhasil disalin ke papan klip!');
          } catch {
            showToast('Gagal menyalin sandi.', true);
          }
        });
      });

      // 3. Copy Username
      document.querySelectorAll('.btn-copy-username').forEach(btn => {
        btn.addEventListener('click', async () => {
          const uname = btn.getAttribute('data-username') || '';
          if (!uname) return;
          try {
            await navigator.clipboard.writeText(`@${uname}`);
            const icon = btn.querySelector('i');
            if (icon) {
              icon.className = 'bi bi-check2 text-success';
              setTimeout(() => {
                icon.className = 'bi bi-clipboard';
              }, 1500);
            }
            showToast(`Username @${uname} disalin!`);
          } catch {
            showToast('Gagal menyalin username.', true);
          }
        });
      });

      // 4. Edit Account Button
      document.querySelectorAll('.btn-edit-account').forEach(btn => {
        btn.addEventListener('click', () => {
          const userId = btn.getAttribute('data-id');
          const user = allUsers.find(u => u.id === userId);
          if (user) {
            openEditModal(user);
          }
        });
      });
    }

    // Buka Modal Edit Akun
    function openEditModal(user: any) {
      const editUserId = document.getElementById('editUserId') as HTMLInputElement;
      const isSelfEditFlag = document.getElementById('isSelfEditFlag') as HTMLInputElement;
      const inputEditNama = document.getElementById('inputEditNama') as HTMLInputElement;
      const selectEditRole = document.getElementById('selectEditRole') as HTMLSelectElement;
      const inputEditUsername = document.getElementById('inputEditUsername') as HTMLInputElement;
      const inputEditPassword = document.getElementById('inputEditPassword') as HTMLInputElement;
      const switchEditIsActive = document.getElementById('switchEditIsActive') as HTMLInputElement;
      const modalEditUserTitle = document.getElementById('modalEditUserTitle');
      const modalEditUserSubtitle = document.getElementById('modalEditUserSubtitle');

      const isSelf = currentSession && (currentSession.id === user.id || currentSession.username === user.username);

      if (editUserId) editUserId.value = user.id;
      if (isSelfEditFlag) isSelfEditFlag.value = isSelf ? 'true' : 'false';
      if (inputEditNama) inputEditNama.value = user.nama_lengkap || '';
      if (selectEditRole) selectEditRole.value = user.role || 'verifikator';
      if (inputEditUsername) inputEditUsername.value = (user.username || '').replace(/^@+/, '');
      if (inputEditPassword) {
        inputEditPassword.value = user.password || '';
        inputEditPassword.type = 'password';
      }
      if (switchEditIsActive) switchEditIsActive.checked = user.is_active !== false;

      // Jika mengedit akun sendiri, kunci role agar tidak sengaja turun pangkat
      if (selectEditRole) {
        selectEditRole.disabled = isSelf;
      }

      if (modalEditUserTitle) {
        modalEditUserTitle.textContent = isSelf ? 'Ubah Kredensial Akun Saya (Super Admin)' : `Edit Kredensial: ${user.nama_lengkap}`;
      }
      if (modalEditUserSubtitle) {
        modalEditUserSubtitle.textContent = isSelf ? 'Pastikan Anda mengingat username dan kata sandi baru ini.' : `Perbarui data akun @${(user.username || '').replace(/^@+/, '')}`;
      }

      // @ts-ignore
      const modalEl = document.getElementById('modalEditUser');
      // @ts-ignore
      if (window.bootstrap && window.bootstrap.Modal) {
        // @ts-ignore
        const modal = new window.bootstrap.Modal(modalEl);
        modal.show();
      }
    }

    // Toggle Show Password in Modal
    const btnToggleEditPassword = document.getElementById('btnToggleEditPassword');
    const inputEditPassword = document.getElementById('inputEditPassword') as HTMLInputElement;
    const toggleEditPasswordIcon = document.getElementById('toggleEditPasswordIcon');
    if (btnToggleEditPassword && inputEditPassword && toggleEditPasswordIcon) {
      btnToggleEditPassword.addEventListener('click', () => {
        if (inputEditPassword.type === 'password') {
          inputEditPassword.type = 'text';
          toggleEditPasswordIcon.className = 'bi bi-eye-slash';
        } else {
          inputEditPassword.type = 'password';
          toggleEditPasswordIcon.className = 'bi bi-eye';
        }
      });
    }

    // Generator Kata Sandi Acak Kuat
    const btnGeneratePassword = document.getElementById('btnGeneratePassword');
    if (btnGeneratePassword && inputEditPassword) {
      btnGeneratePassword.addEventListener('click', () => {
        const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz';
        const numbers = '23456789';
        const specials = '!@#$%^&*';
        let pass = 'KKA#';
        for (let i = 0; i < 4; i++) pass += letters.charAt(Math.floor(Math.random() * letters.length));
        for (let i = 0; i < 3; i++) pass += numbers.charAt(Math.floor(Math.random() * numbers.length));
        pass += specials.charAt(Math.floor(Math.random() * specials.length));
        pass += '.';

        inputEditPassword.value = pass;
        inputEditPassword.type = 'text';
        if (toggleEditPasswordIcon) toggleEditPasswordIcon.className = 'bi bi-eye-slash';
        showToast('Sandi acak kuat berhasil dibuat!');
      });
    }

    // Form Submit Handler: Update Akun ke Supabase
    const formEditUser = document.getElementById('formEditUser');
    const btnSaveUser = document.getElementById('btnSaveUser') as HTMLButtonElement;
    if (formEditUser && btnSaveUser) {
      formEditUser.addEventListener('submit', async (e) => {
        e.preventDefault();

        const editUserId = (document.getElementById('editUserId') as HTMLInputElement)?.value;
        const inputEditNama = (document.getElementById('inputEditNama') as HTMLInputElement)?.value.trim();
        const selectEditRole = (document.getElementById('selectEditRole') as HTMLSelectElement)?.value;
        const inputEditUsername = (document.getElementById('inputEditUsername') as HTMLInputElement)?.value.trim().replace(/^@+/, '');
        const inputEditPasswordVal = (document.getElementById('inputEditPassword') as HTMLInputElement)?.value;
        const switchEditIsActive = (document.getElementById('switchEditIsActive') as HTMLInputElement)?.checked;

        if (!editUserId || !inputEditNama || !inputEditUsername || !inputEditPasswordVal) {
          alert('Mohon lengkapi seluruh kolom yang wajib diisi.');
          return;
        }

        // Cek duplikasi username pada akun lain
        const duplicate = allUsers.find(u => (u.username || '').toLowerCase() === inputEditUsername.toLowerCase() && u.id !== editUserId);
        if (duplicate) {
          alert(`Username "@${inputEditUsername}" sudah digunakan oleh petugas lain (${duplicate.nama_lengkap}). Silakan gunakan username lain.`);
          return;
        }

        const originalBtnText = btnSaveUser.innerHTML;
        btnSaveUser.disabled = true;
        btnSaveUser.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Menyimpan perubahan...';

        try {
          // 1. UPDATE KE DATABASE
          const { error } = await supabase
            .from('admin_users')
            .update({
              nama_lengkap: inputEditNama,
              role: selectEditRole,
              username: inputEditUsername,
              password: inputEditPasswordVal,
              is_active: switchEditIsActive
            })
            .eq('id', editUserId);

          if (error) throw error;

          // 2. JIKA AKUN SENDIRI DIUBAH, UPDATE SESI BROWSER OTOMATIS
          const isSelf = currentSession && (currentSession.id === editUserId || currentSession.username === inputEditUsername);
          if (isSelf) {
            currentSession.nama = inputEditNama;
            currentSession.username = inputEditUsername;
            currentSession.role = selectEditRole;

            sessionStorage.setItem('kka_admin_session', JSON.stringify(currentSession));
            if (localStorage.getItem('kka_admin_session')) {
              localStorage.setItem('kka_admin_session', JSON.stringify(currentSession));
            }

            // Update Header Profil di Layar
            const adminUserDisplayName = document.getElementById('adminUserDisplayName');
            const adminUserSubRole = document.getElementById('adminUserSubRole');
            const adminDropdownName = document.getElementById('adminDropdownName');
            if (adminUserDisplayName) adminUserDisplayName.textContent = inputEditNama;
            if (adminUserSubRole) adminUserSubRole.textContent = `@${inputEditUsername} • Super Admin`;
            if (adminDropdownName) adminDropdownName.textContent = inputEditNama;

            initSelfAccount();
          }

          // 3. TUTUP MODAL & TAMPILKAN TOAST SUKSES
          // @ts-ignore
          const modalEl = document.getElementById('modalEditUser');
          // @ts-ignore
          if (window.bootstrap && window.bootstrap.Modal) {
            // @ts-ignore
            const modal = window.bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
          }

          showToast(`Kredensial @${inputEditUsername} berhasil diperbarui!`);
          await fetchUsers();

        } catch (err: any) {
          console.error('Update user error:', err);
          alert(`Gagal menyimpan perubahan: ${err.message || 'Terjadi kesalahan'}`);
        } finally {
          btnSaveUser.disabled = false;
          btnSaveUser.innerHTML = originalBtnText;
        }
      });
    }

    // Filter & Search Event Listeners
    const searchUserInput = document.getElementById('searchUserInput') as HTMLInputElement;
    const filterRoleSelect = document.getElementById('filterRoleSelect') as HTMLSelectElement;

    if (searchUserInput) {
      searchUserInput.addEventListener('input', () => {
        searchQuery = searchUserInput.value;
        renderUsersTable();
      });
    }

    if (filterRoleSelect) {
      filterRoleSelect.addEventListener('change', () => {
        roleFilter = filterRoleSelect.value;
        renderUsersTable();
      });
    }

    // Tombol Cepat Ubah Akun Saya
    const btnEditMyAccount = document.getElementById('btnEditMyAccount');
    const btnQuickEditSelf = document.getElementById('btnQuickEditSelf');
    function triggerEditSelf() {
      if (!currentSession) return;
      const selfUser = allUsers.find(u => u.id === currentSession.id || u.username === currentSession.username) || {
        id: currentSession.id,
        username: currentSession.username,
        nama_lengkap: currentSession.nama,
        role: currentSession.role || 'superadmin',
        password: '',
        is_active: true
      };
      openEditModal(selfUser);
    }

    if (btnEditMyAccount) btnEditMyAccount.addEventListener('click', triggerEditSelf);
    if (btnQuickEditSelf) btnQuickEditSelf.addEventListener('click', triggerEditSelf);

    // Tombol Refresh Users
    const btnRefreshUsers = document.getElementById('btnRefreshUsers');
    if (btnRefreshUsers) {
      btnRefreshUsers.addEventListener('click', () => {
        fetchUsers();
      });
    }

    // Setup Awal
    function setupPenggunaPage() {
      initSelfAccount();
      fetchUsers();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPenggunaPage);
    } else {
      setupPenggunaPage();
    }
    document.addEventListener('astro:page-load', setupPenggunaPage);
  </script>

