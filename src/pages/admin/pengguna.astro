---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Kelola Akun Admin & Petugas" activeMenu="pengguna" pageClass="page-dashboard">
  <div class="page-dashboard">
    <!-- PAGE HERO BANNER -->
    <div class="dashboard-hero mb-4">
      <div class="dashboard-hero-copy">
        <span class="dashboard-eyebrow">MANAJEMEN HAK AKSES &bull; KKA 2026</span>
        <h1>Kelola Akun Admin & Petugas</h1>
        <p>
          Kelola kredensial akun panitia, hak akses peran (Super Admin, Admin Sekretariat, Verifikator), serta ubah username dan kata sandi akun Anda sendiri secara aman di sistem resmi KKA.
        </p>
      </div>

      <div class="dashboard-hero-actions">
        <button type="button" class="btn btn-primary" id="btnEditMyAccount">
          <i class="bi bi-person-fill-gear"></i>
          <span>Ubah Kredensial Saya</span>
        </button>
        <button type="button" class="btn btn-light border" id="btnRefreshUsers">
          <i class="bi bi-arrow-clockwise"></i>
          <span>Segarkan Data</span>
        </button>
      </div>
    </div>

    <!-- PROFIL SUPER ADMIN AKTIF (SPACIOUS & ELEGANT) -->
    <div class="petugas-self-card mb-4">
      <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
        <!-- Sisi Kiri: Avatar & Info Pengguna -->
        <div class="d-flex align-items-center gap-4 flex-wrap flex-sm-nowrap">
          <div class="petugas-self-avatar flex-shrink-0" id="selfAvatarBadge">
            SA
          </div>
          <div>
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
              <span class="petugas-badge-highlight">
                <i class="bi bi-person-check-fill"></i>
                <span>AKUN SAYA AKTIF</span>
              </span>
              <span class="petugas-badge-role" id="selfRoleBadge">
                <i class="bi bi-shield-lock-fill"></i>
                <span>Super Admin (Akses Penuh)</span>
              </span>
            </div>
            <h2 class="petugas-self-name mb-2" id="selfDisplayName">
              Super Admin Radar Kediri
            </h2>
            <div class="petugas-self-meta-bar">
              <span class="petugas-meta-username" id="selfUsername">@superadmin.kka</span>
              <span class="petugas-meta-item">
                <span class="status-indicator-dot"></span>
                <span class="meta-label">Status:</span>
                <span class="petugas-status-pill">Aktif</span>
              </span>
              <span class="petugas-meta-item">
                <i class="bi bi-clock-history text-muted"></i>
                <span class="meta-label">Sesi:</span>
                <strong class="text-dark" id="selfSessionTime">Aktif Sekarang</strong>
              </span>
            </div>
          </div>
        </div>

        <!-- Sisi Kanan: Tombol Ubah Kredensial -->
        <div class="flex-shrink-0">
          <button type="button" class="btn-petugas-action-key" id="btnQuickEditSelf">
            <i class="bi bi-key-fill fs-6"></i>
            <span>Ganti Username & Kata Sandi</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 4 KPI STATS CARDS -->
    <div class="row g-3 g-lg-4 mb-4">
      <!-- Card 1: Total Petugas -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="petugas-kpi-card">
          <div class="petugas-kpi-icon kpi-blue">
            <i class="bi bi-people-fill"></i>
          </div>
          <div class="petugas-kpi-content">
            <span class="petugas-kpi-label">TOTAL PETUGAS</span>
            <strong class="petugas-kpi-val" id="statTotalUsers">4</strong>
            <span class="petugas-kpi-sub">
              <i class="bi bi-person-check text-success"></i>
              <span>Akun Terdaftar</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Card 2: Super Admin -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="petugas-kpi-card">
          <div class="petugas-kpi-icon kpi-amber">
            <i class="bi bi-shield-shaded"></i>
          </div>
          <div class="petugas-kpi-content">
            <span class="petugas-kpi-label">SUPER ADMIN</span>
            <strong class="petugas-kpi-val" id="statSuperAdmin">1</strong>
            <span class="petugas-kpi-sub">
              <i class="bi bi-person-fill-lock text-warning"></i>
              <span>Pimpinan / IT Master</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Card 3: Admin Panitia -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="petugas-kpi-card">
          <div class="petugas-kpi-icon kpi-teal">
            <i class="bi bi-person-badge-fill"></i>
          </div>
          <div class="petugas-kpi-content">
            <span class="petugas-kpi-label">ADMIN SEKRETARIAT</span>
            <strong class="petugas-kpi-val" id="statAdminPanitia">1</strong>
            <span class="petugas-kpi-sub">
              <i class="bi bi-sliders text-info"></i>
              <span>CMS & Wilayah</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Card 4: Verifikator -->
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="petugas-kpi-card">
          <div class="petugas-kpi-icon kpi-emerald">
            <i class="bi bi-check2-all"></i>
          </div>
          <div class="petugas-kpi-content">
            <span class="petugas-kpi-label">VERIFIKATOR</span>
            <strong class="petugas-kpi-val" id="statVerifikator">2</strong>
            <span class="petugas-kpi-sub">
              <i class="bi bi-receipt text-success"></i>
              <span>Cek Struk & Pembayaran</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- TABEL MANAJEMEN PENGGUNA -->
    <div class="petugas-table-card mb-4">
      <!-- Card Header (Spacious, No Supabase text, Dedicated Icon & Subtitle) -->
      <div class="petugas-table-header">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
          <!-- Title Left -->
          <div class="petugas-header-title-box">
            <div class="d-flex align-items-center gap-3">
              <div class="petugas-title-icon">
                <i class="bi bi-person-gear"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2.5 flex-wrap">
                  <h2 class="petugas-table-title mb-0">Daftar Akun Petugas Resmi KKA 2026</h2>
                  <span class="petugas-count-pill" id="badgeTotalCount">4 Petugas</span>
                </div>
                <p class="petugas-table-subtitle mb-0 mt-1">
                  Kelola kredensial login, peran akses, dan status keaktifan seluruh panitia & verifikator.
                </p>
              </div>
            </div>
          </div>

          <!-- Controls Right (Search & Filter) -->
          <div class="d-flex align-items-center gap-2.5 flex-wrap flex-sm-nowrap">
            <div class="input-group input-group-sm petugas-search-group">
              <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-search"></i></span>
              <input type="text" class="form-control border-start-0 pe-3" id="searchUserInput" placeholder="Cari nama, username..." />
            </div>
            <select class="form-select form-select-sm petugas-filter-select" id="filterRoleSelect">
              <option value="all">Semua Peran</option>
              <option value="superadmin">Super Admin</option>
              <option value="admin">Admin Sekretariat</option>
              <option value="verifikator">Verifikator</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Table Area -->
      <div class="table-responsive">
        <table class="table align-middle mb-0 petugas-table" id="usersTable">
          <thead>
            <tr>
              <th class="ps-4" style="width: 55px;">No</th>
              <th>Nama Petugas & Peran</th>
              <th>Username Login</th>
              <th>Kata Sandi</th>
              <th>Status</th>
              <th>Terakhir Login</th>
              <th class="text-end pe-4" style="width: 120px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                <span>Memuat data akun petugas...</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Footer Info -->
      <div class="petugas-table-footer">
        <div>
          <i class="bi bi-info-circle me-1.5 text-primary"></i>
          <span>Klik ikon mata untuk melihat kata sandi atau klik tombol salin untuk menyalin ke papan klip.</span>
        </div>
        <div id="userSummaryText" class="fw-bold text-secondary">
          Memuat akun...
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL EDIT KREDENSIAL AKUN -->
  <div class="modal fade" id="modalEditUser" tabindex="-1" aria-labelledby="modalEditUserTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="modal-header bg-light border-bottom p-3">
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
              <h5 class="modal-title fs-6 fw-bold mb-0 text-dark" id="modalEditUserTitle">Edit Kredensial Petugas</h5>
              <span class="text-muted" style="font-size: 0.75rem;" id="modalEditUserSubtitle">Perbarui username, kata sandi, atau peran akses.</span>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>

        <form id="formEditUser">
          <div class="modal-body p-3 p-md-4">
            <input type="hidden" id="editUserId" value="" />
            <input type="hidden" id="isSelfEditFlag" value="false" />

            <!-- Nama Lengkap -->
            <div class="mb-3">
              <label class="form-label fw-bold text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Nama Lengkap Petugas <span class="text-danger">*</span></label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                <input type="text" class="form-control border-start-0" id="inputEditNama" required placeholder="Contoh: Mas Fajar (Verifikator)" />
              </div>
            </div>

            <!-- Role / Peran Akses -->
            <div class="mb-3">
              <label class="form-label fw-bold text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Peran Akses Dashboard <span class="text-danger">*</span></label>
              <select class="form-select form-select-sm" id="selectEditRole" required>
                <option value="superadmin">Super Admin (Akses Penuh Seluruh Sistem & Biaya)</option>
                <option value="admin">Admin Sekretariat (Kelola CMS, Wilayah, & Pendaftaran)</option>
                <option value="verifikator">Verifikator Keuangan (Hanya Data Pendaftaran & Struk)</option>
              </select>
              <div class="form-text text-muted mt-1" id="roleDescriptionHelp" style="font-size: 0.75rem;">
                Verifikator hanya dapat memvalidasi bukti transfer pendaftar.
              </div>
            </div>

            <!-- Username -->
            <div class="mb-3">
              <label class="form-label fw-bold text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Username Login <span class="text-danger">*</span></label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 font-monospace text-muted">@</span>
                <input type="text" class="form-control font-monospace border-start-0" id="inputEditUsername" required placeholder="superadmin.kka" pattern="[a-zA-Z0-9._-]{3,30}" />
              </div>
              <div class="form-text text-muted" style="font-size: 0.72rem;">Gunakan kombinasi huruf, angka, titik, atau garis bawah tanpa spasi (3-30 karakter).</div>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <label class="form-label fw-bold text-secondary text-uppercase mb-0" style="font-size: 0.75rem;">Kata Sandi Baru <span class="text-danger">*</span></label>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" id="btnGeneratePassword" style="font-size: 0.75rem;">
                  <i class="bi bi-magic me-1"></i>Buat Sandi Acak Kuat
                </button>
              </div>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                <input type="password" class="form-control font-monospace border-start-0 border-end-0" id="inputEditPassword" required placeholder="Minimal 6 karakter" minlength="6" />
                <button class="btn btn-outline-secondary btn-sm" type="button" id="btnToggleEditPassword" title="Lihat / Sembunyikan Sandi">
                  <i class="bi bi-eye" id="toggleEditPasswordIcon"></i>
                </button>
              </div>
            </div>

            <!-- Status Aktif / Nonaktif -->
            <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
              <div>
                <strong class="text-dark d-block" style="font-size: 0.825rem;">Status Akun Aktif</strong>
                <span class="text-muted" style="font-size: 0.75rem;">Jika dinonaktifkan, akun ini tidak dapat digunakan untuk login ke dashboard.</span>
              </div>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="switchEditIsActive" checked style="width: 2.4em; height: 1.25em; cursor: pointer;" />
              </div>
            </div>

            <!-- Alert Notice -->
            <div class="alert alert-info border-info-subtle py-2.5 px-3 mt-3 mb-0 rounded-3 d-flex align-items-start gap-2" style="font-size: 0.75rem;">
              <i class="bi bi-shield-check text-info fs-6 flex-shrink-0 mt-0.5"></i>
              <div>
                Perubahan username dan kata sandi langsung disinkronkan ke database sistem. Jika Anda mengedit akun Anda sendiri, sesi login browser akan otomatis diperbarui.
              </div>
            </div>
          </div>

          <div class="modal-footer p-3 bg-light border-top">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold" id="btnSaveUser">
              <i class="bi bi-check2-circle me-1"></i>
              <span>Simpan Perubahan</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    <div id="penggunaToast" class="toast align-items-center text-white border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body d-flex align-items-center gap-2" id="penggunaToastBody" style="font-size: 0.825rem;">
          <i class="bi bi-check-circle-fill fs-6" id="penggunaToastIcon"></i>
          <span id="penggunaToastMsg">Perubahan berhasil disimpan!</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <!-- SCRIPT LOGIC MANAJEMEN AKUN ADMIN & PETUGAS -->
  <script>
    import { supabase } from '../../lib/supabase';

    let allUsers: any[] = [];
    let currentSession: any = null;
    let searchQuery = '';
    let roleFilter = 'all';

    // Toast Notification Helper
    function showToast(msg: string, isError = false) {
      const toastEl = document.getElementById('penggunaToast');
      const toastBody = document.getElementById('penggunaToastBody');
      const toastMsg = document.getElementById('penggunaToastMsg');
      const toastIcon = document.getElementById('penggunaToastIcon');
      if (!toastEl || !toastBody || !toastMsg || !toastIcon) return;

      toastEl.className = `toast align-items-center text-white border-0 shadow-lg ${isError ? 'bg-danger' : 'bg-success'}`;
      toastIcon.className = `bi ${isError ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill'} fs-6`;
      toastMsg.textContent = msg;

      // @ts-ignore
      if (window.bootstrap && window.bootstrap.Toast) {
        // @ts-ignore
        const toast = new window.bootstrap.Toast(toastEl, { delay: 3500 });
        toast.show();
      } else {
        alert(msg);
      }
    }

    // Role Label & Badge Helper
    // Role Label & Badge Helper (Spacious, Proportional, Clearly Defined)
    function getRoleBadge(role: string) {
      if (role === 'superadmin') {
        return '<span class="petugas-badge badge-superadmin"><i class="bi bi-shield-shaded"></i><span>Super Admin</span></span>';
      } else if (role === 'admin') {
        return '<span class="petugas-badge badge-admin"><i class="bi bi-person-badge-fill"></i><span>Admin Sekretariat</span></span>';
      } else {
        return '<span class="petugas-badge badge-verifikator"><i class="bi bi-check2-square"></i><span>Verifikator</span></span>';
      }
    }

    // Format Date Helper
    function formatDate(isoStr: string | null) {
      if (!isoStr) return '<span class="petugas-lastlogin-empty"><i class="bi bi-dash-circle me-1"></i>Belum login</span>';
      try {
        const d = new Date(isoStr);
        return d.toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        }) + ' ' + d.toLocaleTimeString('id-ID', {
          hour: '2-digit',
          minute: '2-digit'
        }) + ' WIB';
      } catch {
        return isoStr;
      }
    }

    // Inisialisasi Akun Saya
    function initSelfAccount() {
      const rawSession = sessionStorage.getItem('kka_admin_session') || localStorage.getItem('kka_admin_session');
      if (rawSession) {
        try {
          currentSession = JSON.parse(rawSession);
          const selfDisplayName = document.getElementById('selfDisplayName');
          const selfUsername = document.getElementById('selfUsername');
          const selfAvatarBadge = document.getElementById('selfAvatarBadge');
          const selfRoleBadge = document.getElementById('selfRoleBadge');

          if (selfDisplayName) selfDisplayName.textContent = currentSession.nama || 'Super Admin Radar Kediri';
          if (selfUsername) {
            const raw = (currentSession.username || 'superadmin.kka').replace(/^@+/, '');
            selfUsername.textContent = `@${raw}`;
          }
          if (selfAvatarBadge) {
            const initials = (currentSession.nama || 'Super Admin')
              .split(' ')
              .map((w: string) => w[0])
              .filter(Boolean)
              .slice(0, 2)
              .join('')
              .toUpperCase();
            selfAvatarBadge.textContent = initials || 'SA';
          }
          if (selfRoleBadge) {
            selfRoleBadge.innerHTML = currentSession.role === 'superadmin' 
              ? '<i class="bi bi-shield-lock-fill"></i><span>Super Admin (Akses Penuh)</span>' 
              : `<i class="bi bi-person-badge"></i><span>${currentSession.role}</span>`;
          }
        } catch (e) {
          console.warn('Session parse error:', e);
        }
      }
    }

    // Ambil Data Seluruh Pengguna dari Supabase
    async function fetchUsers() {
      const tbody = document.getElementById('usersTableBody');
      const userSummaryText = document.getElementById('userSummaryText');
      if (!tbody) return;

      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            <span>Memuat data akun petugas...</span>
          </td>
        </tr>
      `;

      try {
        const { data, error } = await supabase
          .from('admin_users')
          .select('*')
          .order('role', { ascending: true })
          .order('username', { ascending: true });

        if (error) throw error;

        allUsers = data || [];

        // Update Counter Stats
        const statTotalUsers = document.getElementById('statTotalUsers');
        const statSuperAdmin = document.getElementById('statSuperAdmin');
        const statAdminPanitia = document.getElementById('statAdminPanitia');
        const statVerifikator = document.getElementById('statVerifikator');
        const badgeTotalCount = document.getElementById('badgeTotalCount');

        if (statTotalUsers) statTotalUsers.textContent = allUsers.length.toString();
        if (statSuperAdmin) statSuperAdmin.textContent = allUsers.filter(u => u.role === 'superadmin').length.toString();
        if (statAdminPanitia) statAdminPanitia.textContent = allUsers.filter(u => u.role === 'admin').length.toString();
        if (statVerifikator) statVerifikator.textContent = allUsers.filter(u => u.role === 'verifikator').length.toString();
        if (badgeTotalCount) badgeTotalCount.textContent = `${allUsers.length} Petugas`;

        if (userSummaryText) {
          userSummaryText.textContent = `Total ${allUsers.length} akun petugas terdaftar aktif`;
        }

        renderUsersTable();
      } catch (err: any) {
        console.error('Fetch users error:', err);
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-4 text-danger">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              Gagal memuat data akun: ${err.message || 'Koneksi terputus'}.
            </td>
          </tr>
        `;
        showToast('Gagal memuat akun dari database.', true);
      }
    }

    // Render Tabel Akun Petugas dengan Filter & Pencarian
    function renderUsersTable() {
      const tbody = document.getElementById('usersTableBody');
      if (!tbody) return;

      let filtered = allUsers.filter(u => {
        const matchRole = roleFilter === 'all' || u.role === roleFilter;
        const q = searchQuery.toLowerCase().trim();
        const matchQuery = !q || 
          (u.nama_lengkap || '').toLowerCase().includes(q) || 
          (u.username || '').toLowerCase().includes(q);
        return matchRole && matchQuery;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              <i class="bi bi-search me-1"></i>
              Tidak ada akun petugas yang sesuai dengan kriteria filter.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = '';

      filtered.forEach((u, idx) => {
        const isCurrentSelf = currentSession && (currentSession.id === u.id || currentSession.username === u.username);
        const tr = document.createElement('tr');
        if (isCurrentSelf) {
          tr.className = 'table-primary table-opacity-10';
        }

        const initials = (u.nama_lengkap || u.username)
          .split(' ')
          .map((w: string) => w[0])
          .filter(Boolean)
          .slice(0, 2)
          .join('')
          .toUpperCase() || 'AD';

        const avatarStyle = u.role === 'superadmin' 
          ? 'background: #fff7ed; color: #c2410c; border: 1.5px solid #fed7aa;' 
          : (u.role === 'admin' 
            ? 'background: #eff6ff; color: #1d4ed8; border: 1.5px solid #bfdbfe;' 
            : 'background: #f0fdfa; color: #0f766e; border: 1.5px solid #99f6e4;');

        const uname = (u.username || '').replace(/^@+/, '');

        tr.innerHTML = `
          <td class="ps-4 fw-bold text-muted text-center" style="font-size: 0.85rem;">${idx + 1}</td>
          <td>
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-3 fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 0.9rem; ${avatarStyle}">
                ${initials}
              </div>
              <div>
                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                  <strong class="text-dark" style="font-size: 0.925rem; font-weight: 700;">${u.nama_lengkap || '-'}</strong>
                  ${isCurrentSelf ? '<span class="petugas-badge-anda">Anda</span>' : ''}
                </div>
                <div>${getRoleBadge(u.role)}</div>
              </div>
            </div>
          </td>
          <td>
            <div class="user-pill-username">
              <span class="user-pill-at">@</span>
              <span class="user-pill-val">${uname}</span>
              <button type="button" class="btn-copy-username" data-username="${uname}" title="Salin Username">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </td>
          <td>
            <div class="user-pill-password">
              <span class="password-display-text" data-pass="${u.password}" data-revealed="false">
                ••••••••••••
              </span>
              <div class="d-flex align-items-center gap-1.5 border-start ps-2 ms-1">
                <button type="button" class="btn-peek-pass" title="Lihat / Sembunyikan Sandi">
                  <i class="bi bi-eye"></i>
                </button>
                <button type="button" class="btn-copy-pass" data-pass="${u.password}" title="Salin Sandi">
                  <i class="bi bi-clipboard"></i>
                </button>
